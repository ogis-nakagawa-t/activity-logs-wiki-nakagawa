{
  "servers": {
    "microsoft.docs.mcp": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "msedge"
      ]
    },
    "foam": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "foam-cli@0.46.4",
        "mcp"
      ],
      "env": {
        "FOAM_TELEMETRY": "0"
      }
    }
  }
}
